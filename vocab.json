w/f06.mp3", "cat": "Pratos"}, {"en": "french fries", "pr": "fréntch FRÁIZ", "ipa": "/ˌfrentʃ ˈfraɪz/", "pt": "batata frita", "audio": "media/l2w/f07.mp3", "cat": "Pratos"}, {"en": "a burger", "pr": "BÂR-guer", "ipa": "/ˈbɜːrɡər/", "pt": "hambúrguer", "audio": "media/l2w/f08.mp3", "cat": "Pratos"}, {"en": "cake", "pr": "KÊIK", "ipa": "/keɪk/", "pt": "bolo", "audio": "media/l2w/f09.mp3", "cat": "Sobremesas"}, {"en": "ice cream", "pr": "ÁIS krim", "ipa": "/ˈaɪs kriːm/", "pt": "sorvete", "audio": "media/l2w/f10.mp3", "cat": "Sobremesas"}, {"en": "pie", "pr": "PÁI", "ipa": "/paɪ/", "pt": "torta (doce)", "audio": "media/l2w/f11.mp3", "cat": "Sobremesas"}, {"en": "flan", "pr": "FLÉN", "ipa": "/flæn/", "pt": "pudim", "audio": "media/l2w/f12.mp3", "cat": "Sobremesas"}, {"en": "a brownie", "pr": "BRÁU-ni", "ipa": "/ˈbraʊni/", "pt": "brownie", "audio": "media/l2w/f13.mp3", "cat": "Sobremesas"}, {"en": "cheesecake", "pr": "TCHÍZ-keik", "ipa": "/ˈtʃiːzkeɪk/", "pt": "cheesecake", "audio": "media/l2w/f14.mp3", "cat": "Sobremesas"}, {"en": "fruit salad", "pr": "FRÚT sé-lad", "ipa": "/ˈfruːt ˌsæləd/", "pt": "salada de frutas", "audio": "media/l2w/f15.mp3", "cat": "Sobremesas"}, {"en": "chocolate mousse", "pr": "TCHÓ-klat MÚS", "ipa": "/ˈtʃɑːklət ˈmuːs/", "pt": "mousse de chocolate", "audio": "media/l2w/f16.mp3", "cat": "Sobremesas"}], "jogo": {"G01": "Bem-vindo ao restaurante! Eu sou o garçom e você é o cliente. Responda em inglês, usando a frase da tela. Let's start!", "A1": "Good evening! How many people?", "A2": "Please, have a seat.", "A3": "Anything to drink?", "A4": "Are you ready to order?", "A5": "How is everything?", "A6": "Anything else?", "P1": "Perfect! Follow me, please.", "P2": "Here's the menu.", "P3": "Great choice!", "P4": "Excellent! Coming right up.", "P5": "I'm glad you like it!", "P6": "Sure! Here's your bill.", "C1": "Muito bem! Só um ajuste: diga a frase completa. Say: A table for two, please.", "C2": "Só um ajuste: para pedir o cardápio, diga: Can I see the menu, please?", "C3": "Só um ajuste: I want soa direto demais. Diga: I'd like, e a bebida.", "C4": "Só um ajuste: antes de som de vogal, use an. Like this: an orange juice.", "C5": "Só um ajuste: Give me soa grosseiro. Diga: Can I have, e o prato.", "C6": "Quase! Lembre do please no final. É ele que deixa o pedido educado.", "C7": "Só um ajuste: responda com a frase completa. Say: It's delicious, thank you.", "C8": "Só um ajuste: conta não é account. Diga: Can you bring the bill, please?", "C9": "Muito bem! Para soar ainda mais gentil, use could: Could you bring the bill, please?", "R1": "Pode repetir, por favor? Can you say it again?", "M1": "Sem problema. Repita comigo: A table for two, please.", "M2": "Sem problema. Repita comigo: Can I see the menu, please?", "M3": "Sem problema. Repita comigo: I'd like a coffee, please.", "M4": "Sem problema. Repita comigo: Can I have the chicken, please?", "M5": "Sem problema. Repita comigo: It's delicious, thank you.", "M6": "Sem problema. Repita comigo: No, thank you. Can you bring the bill, please?", "F1": "Muito bem! Você passou pelos seis passos do restaurante. Lição dois concluída. See you tomorrow!"}, "l3": [{"en": "hello", "pr": "ré-LOU", "ipa": "/həˈloʊ/", "pt": "olá", "audio": "media/l3w/w01.mp3", "cat": "Cumprimentar"}, {"en": "hi", "pr": "RÁI", "ipa": "/haɪ/", "pt": "oi", "audio": "media/l3w/w02.mp3", "cat": "Cumprimentar"}, {"en": "good morning", "pr": "gud MÓR-nin", "ipa": "/ɡʊd ˈmɔːrnɪŋ/", "pt": "bom dia", "audio": "media/l3w/w03.mp3", "cat": "Cumprimentar"}, {"en": "good afternoon", "pr": "gud éf-ter-NUUN", "ipa": "/ɡʊd ˌæftərˈnuːn/", "pt": "boa tarde", "audio": "media/l3w/w04.mp3", "cat": "Cumprimentar"}, {"en": "good evening", "pr": "gud ÍV-nin", "ipa": "/ɡʊd ˈiːvnɪŋ/", "pt": "boa noite (ao chegar)", "audio": "media/l3w/w05.mp3", "cat": "Noite e perguntas"}, {"en": "good night", "pr": "gud NÁIT", "ipa": "/ɡʊd ˈnaɪt/", "pt": "boa noite (ao sair)", "audio": "media/l3w/w06.mp3", "cat": "Noite e perguntas"}, {"en": "how are you?", "pr": "ráu ar IÚ", "ipa": "/haʊ ɑːr juː/", "pt": "como vai?", "audio": "media/l3w/w07.mp3", "cat": "Noite e perguntas"}, {"en": "how's it going?", "pr": "ráuz it GÔU-in", "ipa": "/haʊz ɪt ˈɡoʊɪŋ/", "pt": "como estão as coisas?", "audio": "media/l3w/w08.mp3", "cat": "Noite e perguntas"}, {"en": "I'm fine", "pr": "áim FÁIN", "ipa": "/aɪm faɪn/", "pt": "estou bem", "audio": "media/l3w/w09.mp3", "cat": "Respostas"}, {"en": "I'm great", "pr": "áim GRÊIT", "ipa": "/aɪm ɡreɪt/", "pt": "estou ótimo(a)", "audio": "media/l3w/w10.mp3", "cat": "Respostas"}, {"en": "not bad", "pr": "nót BÉD", "ipa": "/nɑːt bæd/", "pt": "nada mal", "audio": "media/l3w/w11.mp3", "cat": "Respostas"}, {"en": "how about you?", "pr": "ráu a-BÁUT iu", "ipa": "/haʊ əˈbaʊt juː/", "pt": "e você?", "audio": "media/l3w/w12.mp3", "cat": "Respostas"}, {"en": "nice to meet you", "pr": "náis tu MÍT iu", "ipa": "/naɪs tə ˈmiːt juː/", "pt": "prazer em conhecer", "audio": "media/l3w/w13.mp3", "cat": "Conhecer e se despedir"}, {"en": "bye", "pr": "BÁI", "ipa": "/baɪ/", "pt": "tchau", "audio": "media/l3w/w14.mp3", "cat": "Conhecer e se despedir"}, {"en": "see you tomorrow", "pr": "sí iu tu-MÓ-rou", "ipa": "/siː juː təˈmɑːroʊ/", "pt": "até amanhã", "audio": "media/l3w/w15.mp3", "cat": "Conhecer e se despedir"}, {"en": "have a good day", "pr": "rév a gud DÊI", "ipa": "/hæv ə ɡʊd deɪ/", "pt": "tenha um bom dia", "audio": "media/l3w/w16.mp3", "cat": "Conhecer e se despedir"}], "jogo3": {"G01": "Vamos praticar a Lição 3. Imagine que eu sou um colega novo no escritório. É de manhã. Responda em inglês.", "A1": "Good morning!", "A2": "I'm Pedro. And you?", "A3": "Nice to meet you too! How are you?", "A4": "I'm great, thank you! How's it going today?", "A5": "Well, I have a meeting now.", "A6": "See you tomorrow!", "P1": "Good morning to you too!", "P2": "Great!", "P3": "Good to hear!", "P4": "Awesome!", "P5": "Thanks! You too!", "P6": "Bye!", "C1": "Quase! De manhã, use good morning. Good night é só para ir embora.", "C2": "Muito bem! Só um ajuste: diga a frase inteira. I'm... e o seu nome.", "C3": "Muito bem! Só um ajuste: devolva a pergunta. Diga How about you?", "C4": "Só um ajuste: diga It's going well, ou Not bad.", "C5": "Só um ajuste: durante o dia, diga Have a good day!", "M1": "Sem problema. Repita comigo: Good morning!", "M2": "Sem problema. Repita comigo: I'm Julia. Nice to meet you.", "M3": "Sem problema. Repita comigo: I'm good. How about you?", "M4": "Sem problema. Repita comigo: It's going well.", "M5": "Sem problema. Repita comigo: OK! Have a good day!", "M6": "Sem problema. Repita comigo: See you tomorrow! Bye!", "R1": "Pode repetir, por favor? Can you say it again?", "F1": "Excellent! Você cumprimentou, se apresentou e se despediu. See you in the next lesson!"}}