  "lines": {
   "G01": "Vamos praticar a Lição 3. Imagine que eu sou um colega novo no escritório. É de manhã. Responda em inglês.",
   "A1": "Good morning!",
   "A2": "I'm Pedro. And you?",
   "A3": "Nice to meet you too! How are you?",
   "A4": "I'm great, thank you! How's it going today?",
   "A5": "Well, I have a meeting now.",
   "A6": "See you tomorrow!",
   "P1": "Good morning to you too!",
   "P2": "Great!",
   "P3": "Good to hear!",
   "P4": "Awesome!",
   "P5": "Thanks! You too!",
   "P6": "Bye!",
   "C1": "Quase! De manhã, use good morning. Good night é só para ir embora.",
   "C2": "Muito bem! Só um ajuste: diga a frase inteira. I'm... e o seu nome.",
   "C3": "Muito bem! Só um ajuste: devolva a pergunta. Diga How about you?",
   "C4": "Só um ajuste: diga It's going well, ou Not bad.",
   "C5": "Só um ajuste: durante o dia, diga Have a good day!",
   "M1": "Sem problema. Repita comigo: Good morning!",
   "M2": "Sem problema. Repita comigo: I'm Julia. Nice to meet you.",
   "M3": "Sem problema. Repita comigo: I'm good. How about you?",
   "M4": "Sem problema. Repita comigo: It's going well.",
   "M5": "Sem problema. Repita comigo: OK! Have a good day!",
   "M6": "Sem problema. Repita comigo: See you tomorrow! Bye!",
   "R1": "Pode repetir, por favor? Can you say it again?",
   "F1": "Excellent! Você cumprimentou, se apresentou e se despediu. See you in the next lesson!"
  }
